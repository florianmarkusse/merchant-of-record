# The nightly soak on the laptop (docs/plan-test-setup.md §5). A user unit;
# `deploy/soak.sh install` fills in @REPO@ and installs it.
[Unit]
Description=MoR nightly soak (property tests and fuzzers, large budget)

[Service]
Type=oneshot
ExecStart=@REPO@/deploy/soak.sh run
# Stay out of the way: the laptop may be in use when a missed run starts.
Nice=19
CPUWeight=20
IOSchedulingClass=idle
# No limit of its own: each target's guard in soak.sh bounds the run. A
# limit here went stale as targets were added and cut every run short
# before its alerts (21-Nov-2026 to 25-Nov-2026).
TimeoutStartSec=infinity
